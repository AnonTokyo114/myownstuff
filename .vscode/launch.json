{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run: Personal Research GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "QT_API": "pyside6"
            },
            "justMyCode": false
        },
        {
            "name": "Run: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "QT_API": "pyside6"
            },
            "justMyCode": false
        },
        {
            "name": "Run: core self-tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s",
                ".",
                "-p",
                "test_*.py"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
